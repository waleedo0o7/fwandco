---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="cPanel Compatibility POC"
  description="Foundation status for the cPanel compatibility proof of concept."
>
  <section class="mx-auto flex min-h-screen max-w-3xl items-center px-6 py-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">
        Phase 2
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
        Project foundation is ready for validation.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
        Functional pages and CMS data integration begin only after the
        foundation review gate.
      </p>
    </div>
  </section>
</BaseLayout>
