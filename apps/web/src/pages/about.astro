---
import ContentHero from '../components/ContentHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  canonicalPath="/about/"
  description="Reusable content page foundation."
  title="About | Production Base"
>
  <ContentHero
    description="This minimal page keeps the shared content layout available without introducing product-specific content."
    eyebrow="Reusable page"
    image={null}
    title="Content-ready foundation"
  />
  <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 sm:pb-20">
    <div class="grid gap-5 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-amber-700">01</p>
        <h2 class="mt-3 text-lg font-semibold text-slate-950">
          Static by default
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Product content can be generated as fast, SEO-friendly HTML during the
          Astro build.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-amber-700">02</p>
        <h2 class="mt-3 text-lg font-semibold text-slate-950">
          Managed centrally
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Payload collections, Lexical, media, drafts, and access rules are
          ready for product schemas.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-amber-700">03</p>
        <h2 class="mt-3 text-lg font-semibold text-slate-950">
          Deployment proven
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          The architecture and packaging workflow have been validated on the
          target cPanel environment.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
