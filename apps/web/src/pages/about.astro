---
import ContentHero from '../components/ContentHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getManagedPage, getMedia, getRichTextSummary } from '../lib/cms'

const page = await getManagedPage('about')
const description = getRichTextSummary(page.content)
const image = getMedia(page.image)
const seoImage = getMedia(page.seo.image) ?? image
---

<BaseLayout
  canonicalPath="/about/"
  description={page.seo.description}
  image={seoImage}
  noIndex={page.seo.noIndex ?? false}
  title={page.seo.title}
>
  <ContentHero
    description={description}
    eyebrow="Managed in Payload"
    image={image}
    title={page.heading}
  />
  <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8 sm:pb-20">
    <div class="grid gap-5 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-amber-700">01</p>
        <h2 class="mt-3 text-lg font-semibold text-slate-950">
          Static by default
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Published content is generated as fast, SEO-friendly HTML during the
          Astro build.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-amber-700">02</p>
        <h2 class="mt-3 text-lg font-semibold text-slate-950">
          Managed centrally
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Editors work through Payload while access rules stay enforced on the
          server.
        </p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold text-amber-700">03</p>
        <h2 class="mt-3 text-lg font-semibold text-slate-950">
          Ready to validate
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          The same architecture can be packaged later for the target cPanel
          environment.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
