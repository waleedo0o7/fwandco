---
import ContactForm from '../components/ContactForm.astro'
import ContentHero from '../components/ContentHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getManagedPage, getMedia, getRichTextSummary } from '../lib/cms'

const page = await getManagedPage('contact')
const description = getRichTextSummary(page.content)
const image = getMedia(page.image)
const seoImage = getMedia(page.seo.image) ?? image
const contact = page.contactInformation
---

<BaseLayout
  canonicalPath="/contact/"
  description={page.seo.description}
  image={seoImage}
  noIndex={page.seo.noIndex ?? false}
  title={page.seo.title}
>
  <ContentHero
    description={description}
    eyebrow="Managed contact content"
    image={image}
    title={page.heading}
  />
  <section class="mx-auto grid max-w-7xl gap-8 px-5 pb-16 sm:px-8 sm:pb-20 lg:grid-cols-[0.72fr_1.28fr]">
    <aside class="rounded-3xl bg-slate-950 p-7 text-white sm:p-8">
      <p class="eyebrow !text-amber-300">Contact information</p>
      <h2 class="mt-3 text-2xl font-semibold">Fictional test office</h2>
      <dl class="mt-8 space-y-6 text-sm">
        <div>
          <dt class="font-medium text-slate-400">Email</dt>
          <dd class="mt-1 break-all text-base">
            {contact?.email ?? 'Not provided'}
          </dd>
        </div>
        <div>
          <dt class="font-medium text-slate-400">Phone</dt>
          <dd class="mt-1 text-base">{contact?.phone ?? 'Not provided'}</dd>
        </div>
        <div>
          <dt class="font-medium text-slate-400">Address</dt>
          <dd class="mt-1 text-base leading-7">
            {contact?.address ?? 'Not provided'}
          </dd>
        </div>
      </dl>
    </aside>
    <ContactForm />
  </section>
</BaseLayout>
