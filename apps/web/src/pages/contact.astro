---
import ContactForm from '../components/ContactForm.astro'
import ContentHero from '../components/ContentHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  canonicalPath="/contact/"
  description="Reusable contact page and secure submission endpoint."
  title="Contact | Production Base"
>
  <ContentHero
    description="This minimal page preserves the validated contact submission workflow for future product customization."
    eyebrow="Reusable form"
    image={null}
    title="Contact-ready foundation"
  />
  <section class="mx-auto grid max-w-7xl gap-8 px-5 pb-16 sm:px-8 sm:pb-20 lg:grid-cols-[0.72fr_1.28fr]">
    <aside class="rounded-3xl bg-slate-950 p-7 text-white sm:p-8">
      <p class="eyebrow !text-amber-300">Contact information</p>
      <h2 class="mt-3 text-2xl font-semibold">Contact information</h2>
      <dl class="mt-8 space-y-6 text-sm">
        <div>
          <dt class="font-medium text-slate-400">Email</dt>
          <dd class="mt-1 break-all text-base">
            Configure in the product project
          </dd>
        </div>
        <div>
          <dt class="font-medium text-slate-400">Phone</dt>
          <dd class="mt-1 text-base">Configure in the product project</dd>
        </div>
        <div>
          <dt class="font-medium text-slate-400">Address</dt>
          <dd class="mt-1 text-base leading-7">
            Configure in the product project
          </dd>
        </div>
      </dl>
    </aside>
    <ContactForm />
  </section>
</BaseLayout>
