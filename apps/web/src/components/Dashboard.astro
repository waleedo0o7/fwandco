<section
  aria-labelledby="dashboard-title"
  class="mx-auto max-w-7xl px-5 py-10 sm:px-8 sm:py-14"
>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="eyebrow">Live operational data</p>
      <h1
        id="dashboard-title"
        class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl"
      >
        A clear view of people and assigned work.
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
        This dashboard reads frequently changing records from Payload at runtime
        while the public content pages remain static.
      </p>
    </div>
    <div class="flex items-center gap-2 self-start rounded-full border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 lg:self-auto">
      <span
        class="size-2 rounded-full bg-emerald-500"
        aria-hidden="true"
      ></span>
      Local API connection
    </div>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-3" aria-label="Dashboard summary">
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">People</p>
      <p id="people-count" class="mt-2 text-3xl font-semibold text-slate-950">
        —
      </p>
    </article>
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Groups</p>
      <p id="group-count" class="mt-2 text-3xl font-semibold text-slate-950">
        —
      </p>
    </article>
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-500">Open tasks</p>
      <p id="task-count" class="mt-2 text-3xl font-semibold text-slate-950">
        —
      </p>
    </article>
  </div>

  <div class="mt-8 rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-end sm:justify-between sm:p-6">
      <div>
        <h2 class="text-xl font-semibold text-slate-950">People directory</h2>
        <p class="mt-1 text-sm text-slate-500">
          Filter the live records by team or current task status.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="text-sm font-semibold text-slate-700">
          Group
          <select id="group-filter" class="field mt-1 min-w-44" disabled>
            <option value="all">All groups</option>
          </select>
        </label>
        <label class="text-sm font-semibold text-slate-700">
          Task status
          <select id="status-filter" class="field mt-1 min-w-44" disabled>
            <option value="all">All statuses</option>
            <option value="pending">Pending</option>
            <option value="in_progress">In progress</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </label>
      </div>
    </div>

    <div id="dashboard-state" class="p-8 text-center" aria-live="polite">
      <div
        class="mx-auto size-8 animate-spin rounded-full border-4 border-slate-200 border-t-amber-600"
        aria-hidden="true"
      ></div>
      <p class="mt-3 text-sm font-medium text-slate-600">
        Loading dashboard data…
      </p>
    </div>

    <div id="dashboard-content" class="hidden">
      <div id="people-cards" class="grid gap-4 p-4 md:hidden"></div>
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-6 py-4">Person</th>
              <th class="px-6 py-4">Group</th>
              <th class="px-6 py-4">Phone</th>
              <th class="px-6 py-4">Address</th>
              <th class="px-6 py-4">Assigned tasks</th>
            </tr>
          </thead>
          <tbody id="people-table" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
      <p
        id="empty-state"
        class="hidden px-6 py-12 text-center text-sm text-slate-500"
      >
        No people match the selected filters.
      </p>
    </div>
  </div>
</section>

<script>
  const cmsUrl = import.meta.env.PUBLIC_CMS_URL.replace(/\/$/, '')

  type Identifier = number
  type Relation<T> = Identifier | T
  type PayloadList<T> = { docs: T[]; totalDocs: number }
  type Group = { id: number; name: string }
  type Person = {
    id: number
    group: Relation<Group>
    jobTitle?: string | null
    name: string
  }
  type Phone = { id: number; number: string; person: Relation<Person> }
  type Address = {
    city: string
    id: number
    label: string
    line1: string
    person: Relation<Person>
  }
  type Task = { id: number; status: TaskStatus; title: string }
  type Assignment = {
    id: number
    person: Relation<Person>
    task: Relation<Task>
  }
  type TaskStatus = 'cancelled' | 'completed' | 'in_progress' | 'pending'

  const elements = {
    cards: document.querySelector<HTMLDivElement>('#people-cards')!,
    content: document.querySelector<HTMLDivElement>('#dashboard-content')!,
    empty: document.querySelector<HTMLParagraphElement>('#empty-state')!,
    groupCount: document.querySelector<HTMLParagraphElement>('#group-count')!,
    groupFilter: document.querySelector<HTMLSelectElement>('#group-filter')!,
    peopleCount: document.querySelector<HTMLParagraphElement>('#people-count')!,
    state: document.querySelector<HTMLDivElement>('#dashboard-state')!,
    statusFilter: document.querySelector<HTMLSelectElement>('#status-filter')!,
    table: document.querySelector<HTMLTableSectionElement>('#people-table')!,
    taskCount: document.querySelector<HTMLParagraphElement>('#task-count')!,
  }

  const relationId = <T extends { id: number }>(value: Relation<T>) =>
    typeof value === 'number' ? value : value.id

  const fetchCollection = async <T,>(slug: string) => {
    const response = await fetch(`${cmsUrl}/api/${slug}?limit=100&depth=1`, {
      headers: { Accept: 'application/json' },
    })

    if (!response.ok)
      throw new Error(`${slug} returned HTTP ${response.status}`)
    return (await response.json()) as PayloadList<T>
  }

  const createText = (
    tag: keyof HTMLElementTagNameMap,
    text: string,
    className?: string,
  ) => {
    const element = document.createElement(tag)
    element.textContent = text
    if (className) element.className = className
    return element
  }

  const statusLabel: Record<TaskStatus, string> = {
    cancelled: 'Cancelled',
    completed: 'Completed',
    in_progress: 'In progress',
    pending: 'Pending',
  }

  let groups: Group[] = []
  let people: Person[] = []
  let phones: Phone[] = []
  let addresses: Address[] = []
  let tasks: Task[] = []
  let assignments: Assignment[] = []
  let filtersBound = false

  const getGroup = (person: Person) =>
    groups.find((group) => group.id === relationId(person.group))?.name ??
    'Unassigned'

  const getPersonTasks = (personId: number) => {
    const taskIds = assignments
      .filter((assignment) => relationId(assignment.person) === personId)
      .map((assignment) => relationId(assignment.task))
    return tasks.filter((task) => taskIds.includes(task.id))
  }

  const render = () => {
    const groupValue = elements.groupFilter.value
    const statusValue = elements.statusFilter.value
    const visiblePeople = people.filter((person) => {
      const matchesGroup =
        groupValue === 'all' || String(relationId(person.group)) === groupValue
      const personTasks = getPersonTasks(person.id)
      const matchesStatus =
        statusValue === 'all' ||
        personTasks.some((task) => task.status === statusValue)
      return matchesGroup && matchesStatus
    })

    elements.cards.replaceChildren()
    elements.table.replaceChildren()
    elements.empty.classList.toggle('hidden', visiblePeople.length > 0)

    for (const person of visiblePeople) {
      const personPhones = phones.filter(
        (phone) => relationId(phone.person) === person.id,
      )
      const personAddresses = addresses.filter(
        (address) => relationId(address.person) === person.id,
      )
      const personTasks = getPersonTasks(person.id)
      const phoneText =
        personPhones.map((phone) => phone.number).join(', ') || 'Not provided'
      const addressText =
        personAddresses
          .map((address) => `${address.line1}, ${address.city}`)
          .join(' · ') || 'Not provided'

      const card = document.createElement('article')
      card.className = 'rounded-2xl border border-slate-200 p-5'
      card.append(
        createText('h3', person.name, 'font-semibold text-slate-950'),
        createText(
          'p',
          person.jobTitle || 'Team member',
          'mt-1 text-sm text-slate-500',
        ),
        createText(
          'p',
          getGroup(person),
          'mt-4 text-sm font-semibold text-amber-800',
        ),
        createText('p', phoneText, 'mt-3 text-sm text-slate-600'),
        createText('p', addressText, 'mt-1 text-sm text-slate-600'),
      )
      const taskList = document.createElement('ul')
      taskList.className = 'mt-4 space-y-2'
      if (personTasks.length === 0) {
        taskList.append(
          createText('li', 'No assigned tasks', 'text-sm text-slate-500'),
        )
      } else {
        personTasks.forEach((task) => {
          taskList.append(
            createText(
              'li',
              `${task.title} · ${statusLabel[task.status]}`,
              'text-sm text-slate-700',
            ),
          )
        })
      }
      card.append(taskList)
      elements.cards.append(card)

      const row = document.createElement('tr')
      row.className = 'text-slate-700'
      const personCell = document.createElement('td')
      personCell.className = 'px-6 py-5'
      personCell.append(
        createText('p', person.name, 'font-semibold text-slate-950'),
        createText(
          'p',
          person.jobTitle || 'Team member',
          'mt-1 text-xs text-slate-500',
        ),
      )
      const values = [
        getGroup(person),
        phoneText,
        addressText,
        personTasks.length
          ? personTasks
              .map((task) => `${task.title} · ${statusLabel[task.status]}`)
              .join(' | ')
          : 'No assigned tasks',
      ]
      row.append(personCell)
      values.forEach((value) => {
        const cell = document.createElement('td')
        cell.className = 'max-w-xs px-6 py-5 align-top leading-6'
        cell.textContent = value
        row.append(cell)
      })
      elements.table.append(row)
    }
  }

  const loadDashboard = async () => {
    elements.state.classList.remove('hidden')
    elements.content.classList.add('hidden')

    try {
      const [
        groupResult,
        peopleResult,
        phoneResult,
        addressResult,
        taskResult,
        assignmentResult,
      ] = await Promise.all([
        fetchCollection<Group>('groups'),
        fetchCollection<Person>('people'),
        fetchCollection<Phone>('phone-numbers'),
        fetchCollection<Address>('addresses'),
        fetchCollection<Task>('tasks'),
        fetchCollection<Assignment>('task-assignments'),
      ])

      groups = groupResult.docs
      people = peopleResult.docs
      phones = phoneResult.docs
      addresses = addressResult.docs
      tasks = taskResult.docs
      assignments = assignmentResult.docs

      elements.peopleCount.textContent = String(people.length)
      elements.groupCount.textContent = String(groups.length)
      elements.taskCount.textContent = String(
        tasks.filter(
          (task) => task.status === 'pending' || task.status === 'in_progress',
        ).length,
      )

      elements.groupFilter.replaceChildren()
      const allGroups = document.createElement('option')
      allGroups.value = 'all'
      allGroups.textContent = 'All groups'
      elements.groupFilter.append(allGroups)
      groups.forEach((group) => {
        const option = document.createElement('option')
        option.value = String(group.id)
        option.textContent = group.name
        elements.groupFilter.append(option)
      })
      elements.groupFilter.value = 'all'
      elements.statusFilter.value = 'all'
      elements.groupFilter.disabled = false
      elements.statusFilter.disabled = false
      if (!filtersBound) {
        elements.groupFilter.addEventListener('change', render)
        elements.statusFilter.addEventListener('change', render)
        filtersBound = true
      }

      elements.state.classList.add('hidden')
      elements.content.classList.remove('hidden')
      render()
    } catch (error) {
      console.error('Dashboard loading failed.', error)
      elements.state.replaceChildren()
      elements.state.append(
        createText(
          'p',
          'Dashboard data could not be loaded.',
          'font-semibold text-rose-700',
        ),
        createText(
          'p',
          'Confirm that the local Payload application is running, then refresh the page.',
          'mt-2 text-sm text-slate-600',
        ),
      )
      const retry = document.createElement('button')
      retry.className = 'button-primary mt-5'
      retry.textContent = 'Try again'
      retry.addEventListener('click', loadDashboard, { once: true })
      elements.state.append(retry)
    }
  }

  void loadDashboard()
</script>
