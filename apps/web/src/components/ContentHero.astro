---
interface Props {
  description: string
  eyebrow: string
  image: null | { alt: string; url: string }
  title: string
}

const { description, eyebrow, image, title } = Astro.props
---

<section class="mx-auto grid max-w-7xl gap-10 px-5 py-12 sm:px-8 sm:py-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:py-20">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-6xl">
      {title}
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">{description}</p>
  </div>
  {image ? (
    <img
      alt={image.alt}
      class="aspect-[3/2] w-full rounded-3xl border border-slate-200 bg-white object-cover shadow-xl shadow-slate-900/10"
      decoding="async"
      height="800"
      loading="eager"
      src={image.url}
      width="1200"
    />
  ) : (
    <div class="grid aspect-[3/2] place-items-center rounded-3xl border border-dashed border-slate-300 bg-white text-sm text-slate-500">
      Add a page image in Payload CMS
    </div>
  )}
</section>
