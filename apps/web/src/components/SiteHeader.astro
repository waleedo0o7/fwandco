---
const pathname = Astro.url.pathname
const links = [
  { href: '/', label: 'Dashboard' },
  { href: '/about/', label: 'About us' },
  { href: '/contact/', label: 'Contact' },
]
---

<header class="border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <a
      class="flex items-center gap-3 text-slate-950"
      href="/"
      aria-label="Northstar POC home"
    >
      <span class="grid size-10 place-items-center rounded-xl bg-slate-950 text-sm font-bold text-white">
        N
      </span>
      <span>
        <span class="block text-sm font-semibold tracking-tight">
          Northstar POC
        </span>
        <span class="block text-xs text-slate-500">Local stack validation</span>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="flex items-center gap-1 rounded-full bg-slate-100 p-1 text-sm font-medium text-slate-600">
        {links.map((link) => {
          const isActive =
            link.href === '/'
              ? pathname === '/'
              : pathname.startsWith(link.href)
          return (
            <li>
              <a
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'block rounded-full px-3 py-2 transition sm:px-4',
                  isActive
                    ? 'bg-white text-slate-950 shadow-sm'
                    : 'hover:bg-white/70 hover:text-slate-950',
                ]}
                href={link.href}
              >
                {link.label}
              </a>
            </li>
          )
        })}
      </ul>
    </nav>
  </div>
</header>
