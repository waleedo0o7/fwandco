<form
  id="contact-form"
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
  novalidate
>
  <div>
    <p class="eyebrow">Send a message</p>
    <h2 class="mt-2 text-2xl font-semibold text-slate-950">Send an enquiry</h2>
    <p class="mt-2 text-sm leading-6 text-slate-600">
      Successful submissions are validated by the backend and stored in
      PostgreSQL.
    </p>
  </div>

  <div class="mt-7 grid gap-5 sm:grid-cols-2">
    <label class="text-sm font-semibold text-slate-700">
      Name
      <input
        class="field mt-1"
        name="name"
        autocomplete="name"
        minlength="2"
        maxlength="100"
        required
      />
    </label>
    <label class="text-sm font-semibold text-slate-700">
      Email
      <input
        class="field mt-1"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
      />
    </label>
    <label class="text-sm font-semibold text-slate-700 sm:col-span-2">
      Phone
      <input
        class="field mt-1"
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="30"
      />
    </label>
    <label class="text-sm font-semibold text-slate-700 sm:col-span-2">
      Message
      <textarea
        class="field mt-1 min-h-36 resize-y"
        name="message"
        minlength="10"
        maxlength="3000"
        required
      ></textarea>
    </label>
    <label
      class="absolute -left-[10000px] top-auto size-px overflow-hidden"
      aria-hidden="true"
    >
      Website
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
    <button class="button-primary" type="submit">
      Send message
    </button>
    <p
      id="contact-status"
      class="text-sm text-slate-600"
      aria-live="polite"
    ></p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!
  const status =
    document.querySelector<HTMLParagraphElement>('#contact-status')!
  const submitButton = form.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  )!
  const cmsUrl = import.meta.env.PUBLIC_CMS_URL.replace(/\/$/, '')
  let startedAt = Date.now()

  form.addEventListener('submit', async (event) => {
    event.preventDefault()

    if (!form.reportValidity()) return

    const formData = new FormData(form)
    const body = {
      email: String(formData.get('email') ?? ''),
      message: String(formData.get('message') ?? ''),
      name: String(formData.get('name') ?? ''),
      phone: String(formData.get('phone') ?? ''),
      startedAt,
      website: String(formData.get('website') ?? ''),
    }

    submitButton.disabled = true
    submitButton.textContent = 'Sending…'
    status.className = 'text-sm text-slate-600'
    status.textContent = 'Submitting your message securely.'

    try {
      const response = await fetch(`${cmsUrl}/api/contact`, {
        body: JSON.stringify(body),
        headers: { 'Content-Type': 'application/json' },
        method: 'POST',
      })

      if (!response.ok) {
        const result = (await response.json().catch(() => null)) as {
          error?: string
        } | null
        throw new Error(
          result?.error || `Request failed with HTTP ${response.status}.`,
        )
      }

      form.reset()
      startedAt = Date.now()
      status.className = 'text-sm font-semibold text-emerald-700'
      status.textContent = 'Message saved successfully.'
    } catch (error) {
      console.error('Contact form submission failed.', error)
      status.className = 'text-sm font-semibold text-rose-700'
      status.textContent =
        error instanceof Error
          ? error.message
          : 'The message could not be submitted.'
    } finally {
      submitButton.disabled = false
      submitButton.textContent = 'Send message'
    }
  })
</script>
