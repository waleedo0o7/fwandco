{
  "name": "reusable-production-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "db:start": "pwsh -NoProfile -File scripts/local-postgres.ps1 start",
    "db:status": "pwsh -NoProfile -File scripts/local-postgres.ps1 status",
    "db:stop": "pwsh -NoProfile -File scripts/local-postgres.ps1 stop",
    "dev": "corepack pnpm --parallel --filter @base/web --filter @base/cms dev",
    "lint": "corepack pnpm --recursive --workspace-concurrency=2 --if-present lint",
    "typecheck": "corepack pnpm --recursive --workspace-concurrency=2 --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "node scripts/astro-build.mjs",
    "build:cms": "corepack pnpm --filter @base/cms build",
    "build:cms:full": "corepack pnpm --filter @base/cms build:full",
    "build": "corepack pnpm build:web && corepack pnpm build:cms",
    "release:cpanel": "pwsh -NoProfile -File scripts/prepare-cpanel.ps1",
    "validate": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm format:check && corepack pnpm build:web"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2"
  }
}
