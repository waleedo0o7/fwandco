{
  "name": "cpanel-full-stack-compatibility-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @poc/web --filter @poc/cms dev",
    "lint": "pnpm --recursive --workspace-concurrency=2 --if-present lint",
    "typecheck": "pnpm --recursive --workspace-concurrency=2 --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "pnpm --filter @poc/web build",
    "build:cms": "pnpm --filter @poc/cms build",
    "build": "pnpm build:web && pnpm build:cms",
    "validate": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build:web"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2"
  }
}
